# Public URL of the application (used for origin checks and links).
APP_URL=http://localhost:3000

# Docker Compose database credentials.
POSTGRES_DB=pauoj
POSTGRES_USER=pauoj
POSTGRES_PASSWORD=pauoj
# Change these if the default ports are already in use on your machine.
POSTGRES_PORT=5432
REDIS_PORT=6379

# PostgreSQL connection string used by the app when running locally.
DATABASE_URL=postgres://pauoj:pauoj@localhost:5432/pauoj

# Redis is used by the judge queue and rate limiting.
REDIS_URL=redis://localhost:6379

# Docker image that safely executes untrusted submissions.
JUDGE_IMAGE=pauoj/judge:latest
JUDGE_SWIFT_IMAGE=pauoj/judge-swift:latest
JUDGE_WORK_DIR=/tmp/pauoj-judge
# Docker Compose bind path for judge scratch files. Must be the same path on
# the host and inside the worker container so the Docker daemon can mount it.
JUDGE_HOST_DIR=/var/lib/pauoj/judge
JUDGE_CONCURRENCY=2

# Used only by `pnpm db:seed`. Change these before deploying.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@pauoj.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_DEMO_DATA=true

# SMTP for verification and password-reset emails. Mailpit is used locally.
SMTP_HOST=localhost
SMTP_PORT=1025
# Host ports exposed by the dev Mailpit service.
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=PAU OJ <noreply@pauoj.local>

# Manual payment details for premium learning modules (optional).
# PAYMENT_METHOD=bKash
# PAYMENT_ACCOUNT_NAME=PAU OJ
# PAYMENT_ACCOUNT_NUMBER=01XXXXXXXXX
# PAYMENT_QR_IMAGE_URL=/payment/qr.png
# PAYMENT_INSTRUCTIONS=Send the exact amount with Send Money, then submit the TrxID.
