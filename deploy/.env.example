# Production deployment values. Copy to deploy/.env and keep it private.
APP_DOMAIN=oj.example.edu
APP_URL=https://oj.example.edu

POSTGRES_DB=pauoj
POSTGRES_USER=pauoj
POSTGRES_PASSWORD=replace-with-a-long-random-password

JUDGE_IMAGE=pauoj/judge:latest
JUDGE_SWIFT_IMAGE=pauoj/judge-swift:latest
JUDGE_CONCURRENCY=2
JUDGE_HOST_DIR=/var/lib/pauoj/judge

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.edu
SEED_ADMIN_PASSWORD=replace-with-a-long-random-password
SEED_DEMO_DATA=false

# Required for email verification and password reset in production.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.edu
SMTP_PASSWORD=replace-with-smtp-password
MAIL_FROM=PAU OJ <noreply@example.edu>

BACKUP_DIR=/var/backups/pauoj
RETENTION_DAYS=14
